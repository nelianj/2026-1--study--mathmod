// Параметры
a = 0.48;
b = 0.031;
c = 0.68;
d = 0.031;

// Система ДУ
function dx = syst2(t, x)
    dx(1) = -a*x(1) + b*x(1)*x(2);
    dx(2) = c*x(2) - d*x(1)*x(2);
endfunction

// Начальные условия
t0 = 0;
x0 = [3; 18];
t = [0:0.1:50];

// Решение
y = ode(x0, t0, t, syst2);

y1 = y(1, :);
y2 = y(2, :);

// ГРАФИК
scf(0);
clf();
plot(t, y1, 'b-', 'LineWidth', 2);
plot(t, y2, 'r--', 'LineWidth', 2);
xlabel('Время');
ylabel('Численность популяции');
title('Модель хищник-жертва (x_0=3, y_0=18)');
legend('Жертвы', 'Хищники');
xgrid();
savefig('lab5_2.png');

scf(1);
clf();
plot(y1, y2, 'k-', 'LineWidth', 2);
xlabel('x, жертвы');
ylabel('y, хищники');
title('Фазовый портрет');
xgrid();
savefig('lab5_2.1.png');

// Стационарная точка
x_c = c / d;   // 0.68 / 0.031 ≈ 21.9355
y_c = a / b;   // 0.48 / 0.031 ≈ 15.4839

// Решение со стационарными начальными условиями
x0_stat = [x_c; y_c];
y_stat = ode(x0_stat, t0, t, syst2);

y1_stat = y_stat(1, :);
y2_stat = y_stat(2, :);

// ГРАФИК
scf(2);
clf();
plot(t, y1_stat, 'b-', 'LineWidth', 2);
plot(t, y2_stat, 'r--', 'LineWidth', 2);
xlabel('Время');
ylabel('Численность популяции');
title('Стационарное состояние: x0 = x_c, y0 = y_c');
legend('Жертвы', 'Хищники');
xgrid();
savefig('lab5_2.2.png');

scf(3);
clf();
plot(y1_stat, y2_stat, 'ko', 'MarkerSize', 10, 'MarkerFaceColor', 'k');
xlabel('x, жертвы');
ylabel('y, хищники');
title('Фазовый портрет (стационарная точка)');
xgrid();
savefig('lab5_2.3.png');
